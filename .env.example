# Password for the web UI and API (username "opencode")
OPENCODE_PASSWORD=

# Host port for the web UI (default 4000)
#OPENCODE_PORT=4000

# OpenCode Console (pay-as-you-go) and OpenCode Go key. The OpenCode server sees this through
# `env_file`; no opencode.json or Dockerfile entry is needed. Model prefixes: opencode/<model>
# for pay-as-you-go, opencode-go/<model> for Go.
#OPENCODE_API_KEY=

# Git identity and SSH signing key (optional; inferred from the host's ~/.gitconfig when unset)
#GIT_USER_NAME=
#GIT_USER_EMAIL=
#GIT_SIGNING_KEY=

# GitHub CLI / HTTPS git auth
#GH_TOKEN=

# Docker MCP Gateway catalog secrets. `make run` maps these to catalog key names in the
# generated, ignored mcp-secrets.env file (GITHUB_PERSONAL_ACCESS_TOKEN becomes
# github.personal_access_token; GH_TOKEN is used as a fallback).
# Keep this fine-grained and limited to the repositories the agent needs.
#GITHUB_PERSONAL_ACCESS_TOKEN=
#CONTEXT7_API_KEY=

# OpenCode built-in web search. Set one provider, or connect one in /connect. The shipped
# `websearch.provider` setting in opencode.json is "random", which chooses an available provider.
#EXA_API_KEY=
#FIRECRAWL_API_KEY=
#PARALLEL_API_KEY=
#TAVILY_API_KEY=
#TINYFISH_API_KEY=

# Optional direct PostHog MCP server (disabled by default in opencode.json).
#POSTHOG_PERSONAL_API_KEY=
