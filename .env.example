# Password for the web UI and API (username "opencode")
OPENCODE_PASSWORD=

# n8n workflow automation (editor at http://localhost:5678; always the latest stable image)
# Encrypts n8n credentials in Postgres. Generate once with: openssl rand -hex 32
# Back it up: changing it makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=
N8N_TIMEZONE=Europe/Paris
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=
N8N_POSTGRES_DB=n8n

# Private SearXNG search backend for n8n (internal only, no host port)
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=

# Git identity and SSH signing key (optional; inferred from the host's ~/.gitconfig when unset)
#GIT_USER_NAME=
#GIT_USER_EMAIL=
#GIT_SIGNING_KEY=

# GitHub CLI / HTTPS git auth
#GH_TOKEN=
