# Password for the web UI and API (username "opencode")
OPENCODE_PASSWORD=

# Host port for the web UI (default 4001)
#OPENCODE_PORT=4001

# Shared bearer token for the MCP stack (docker-compose.mcp.yml) and this client.
# Generate one with: openssl rand -hex 32
MCP_GATEWAY_AUTH_TOKEN=

# Host ports for the MCP endpoints (defaults shown)
#MCP_GATEWAY_PORT=8200
#MCP_CHROME_DEVTOOLS_PORT=8203

# Git identity and SSH signing key (optional; inferred from the host's ~/.gitconfig when unset)
#GIT_USER_NAME=
#GIT_USER_EMAIL=
#GIT_SIGNING_KEY=

# GitHub CLI / HTTPS git auth
#GH_TOKEN=
