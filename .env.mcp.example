# MCP-only secrets for Docker MCP Gateway.
# Copy to .env.mcp and restrict permissions:
#   cp .env.mcp.example .env.mcp
#   chmod 600 .env.mcp
#
# Keys must match Docker MCP catalog names. Do not put OPENCODE_API_KEY,
# OPENCODE_PASSWORD or other application secrets here.
#
# Fine-grained GitHub token for the github-official server; restrict it to the
# repositories and permissions the agent needs.
#github.personal_access_token=

# Optional Context7 API key for higher rate limits.
#context7.api_key=
